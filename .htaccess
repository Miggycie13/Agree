DirectoryIndex index.php
Options -Indexes

<FilesMatch "(?i)^(schema.*\.sql|cda-.+\.(png|jpe?g|webp|pdf)|sample-deposit\.(png|jpe?g|webp|pdf)|permit-[a-f0-9]+\.(png|jpe?g|webp|pdf)|receipt-[a-f0-9]+\.(png|jpe?g|webp|pdf))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
